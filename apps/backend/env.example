# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Option 1: Use connection string
DATABASE_URL=postgresql://root:root@localhost:5432/awoofDB

# Option 2: Use individual config (DATABASE_URL takes precedence)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=awoofDB
DB_USER=root
DB_PASSWORD=root

# Redis Configuration
# Option 1: Use connection string
REDIS_URL=redis://localhost:6379

# Option 2: Use individual config (REDIS_URL takes precedence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long-change-this-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Configuration (Brevo - formerly Sendinblue)
BREVO_API_KEY=
BREVO_FROM_NAME=Awoof
EMAIL_FROM=noreply@awoof.com
SUPPORT_EMAIL=support@awoof.com

# Alternative Email Providers
# SendGrid
SENDGRID_API_KEY=

# AWS SES (Alternative)
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=us-east-1

# AWS S3 (File Storage)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp OTP
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional — if unset, webhook HMAC uses PAYSTACK_SECRET_KEY

# Monitoring

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for magic links and redirects)
FRONTEND_URL=http://localhost:3000

# Student SSO login (opt-in; providers stay disabled until piloted).
# Disabled providers require no credentials: leave these unset.
# GOOGLE_LOGIN_ENABLED=false
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# GOOGLE_LOGIN_CALLBACK_URL=https://api.example.com/api/auth/student/sso/google/callback
# MICROSOFT_LOGIN_ENABLED=false
# MICROSOFT_LOGIN_CLIENT_ID=
# MICROSOFT_LOGIN_CLIENT_SECRET=
# MICROSOFT_LOGIN_CALLBACK_URL=https://api.example.com/api/auth/student/sso/microsoft/callback
# Must have the same origin as FRONTEND_URL; the browser auth state is origin-bound.
# STUDENT_SSO_COMPLETION_URL=https://app.example.com/auth/student/sso/complete
# STUDENT_SSO_ATTEMPT_KEY=base64url-encoded-32-byte-key
# Dedicated recovery-code digest key, recommended for new deployments (min 32 chars).
# Deployments that enrolled codes under STUDENT_SSO_ATTEMPT_KEY keep verifying them
# through a retained fallback after adding this key. Never rotate
# STUDENT_SSO_ATTEMPT_KEY itself while fallback-verified codes may exist.
# STUDENT_ACCOUNT_RECOVERY_CODE_KEY=
# Rotation (K1 -> K2) is staged across two fully completed deploys:
# promoting the write key in one step lets new replicas issue K2 digests
# that old replicas cannot verify yet. Stage 1 (verify-only): set this to
# K2 while the dedicated key stays K1, and deploy everywhere. Stage 2
# (promote): set the dedicated key to K2 with this at K1, and deploy.
# Remove this only after every K1-enrolled code has been re-enrolled.
# The first dedicated key follows the same two stages: stage 1 sets only
# this (issuance stays on the retained attempt key), stage 2 sets the
# dedicated key. Re-enroll any codes that predate the first dedicated key
# before rotating.
# STUDENT_ACCOUNT_RECOVERY_PREVIOUS_CODE_KEY=
# Purpose-separated student email OTP outbox (account recovery and
# passwordless SSO signup): required before either start route is enabled.
# Generate a canonical base64 value encoding exactly 32 random bytes; do not
# reuse the JWT, recovery-code, or SSO attempt key. Every backend replica and
# worker must share it. Purpose and challenge ID are AES-GCM authenticated
# data, so a key cannot cross-deliver recovery and signup codes. Keep the previous key during rotation for at least the
# maximum 5-minute OTP lifetime (plus queue/clock margin); old key IDs remain
# attached to queued ciphertext until delivery, expiry, or terminal cleanup.
# STUDENT_ACCOUNT_RECOVERY_OTP_ENCRYPTION_KEY=
# STUDENT_ACCOUNT_RECOVERY_OTP_PREVIOUS_ENCRYPTION_KEY=
# PASSWORDLESS_STUDENT_SIGNUP_ENABLED=false

# Server-only JSON mapping vendor UUIDs to merchant Paystack credentials:
# {"<vendor-uuid>":{"secret":"sk_test_...","domain":"test"}} where domain is test|live.
# The verifier rejects payments whose provider domain mismatches. Never expose in web/client env.
# Empty mapping disables merchant-account verification; no Awoof-account fallback.
PAYSTACK_MERCHANT_SECRET_KEYS={}
