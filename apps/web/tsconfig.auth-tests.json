{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "src/lib/auth.ts",
    "src/lib/auth-response.ts",
    "src/lib/api-client.ts",
    "src/lib/student-assurance.ts",
    "src/lib/vendor-analytics.ts",
    "src/lib/student-benefit-claim.ts",
    "src/lib/student-login-flow.ts",
    "src/lib/student-return.ts",
    "tests/auth/**/*.ts",
    "src/lib/public-metadata.ts",
    "src/content/public/page-metadata.ts",
    "src/app/sitemap.ts"
  ]
}
