# Copy to .env in repository root before deploying to Hostinger VPS
# cp env.deployment.example .env
# Then edit .env with your real values.

# ========== Frontend (Next.js) ==========
# Public API URL - BAKED INTO THE FRONTEND AT BUILD TIME. Browsers call this URL.
# Set this to your production API before building the web image, e.g.:
#   https://api.awoof.tech   or   http://YOUR_VPS_IP:5001
# If you leave localhost here and build, the live site will call localhost and break.
NEXT_PUBLIC_API_URL=http://localhost:5001

# ========== Backend ==========
NODE_ENV=production
PORT=5000

# Database (must match POSTGRES_* in docker-compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=awoofDB
DB_USER=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis (required in production – backend and Redis container must use the same password)
# Never expose Redis port to the host; backend connects via Docker network (redis:6379).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_PLUS_CHAR_SECRET
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS and frontend URL (your actual frontend URL in production)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ========== Email (Brevo – required for verification emails, OTP, password reset) ==========
# Get your API key from https://app.brevo.com → SMTP & API → API Keys. Without BREVO_API_KEY,
# you get "Failed to send verification email: Email service not configured".
BREVO_API_KEY=
BREVO_FROM_NAME=Awoof
EMAIL_FROM=noreply@yourdomain.com

# ========== Optional: Paystack, SendGrid, WhatsApp, Monitoring ==========
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack Dashboard → Settings → Webhooks (HMAC signature verification)
SENDGRID_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
